rules_version = '2';
// Règles Firestore du site (publiées avec : firebase deploy --only firestore:rules)
// Seuls les comptes créés par le professeur (outils/comptes) portent les marques « eleve » ou « prof ».
// Un compte créé sur le site (@inscrits…) n'a accès qu'à sa propre fiche (inscrits) ou à sa demande de compte
// professeur (demandesProf) ; tout autre compte (ancienne inscription, Google…) ne peut rien lire ni écrire.
service cloud.firestore {
  match /databases/{database}/documents {
    function eleve() { return request.auth != null && request.auth.token.eleve == true; }
    function prof() { return request.auth != null && request.auth.token.prof == true; }
    // Le prénom, le nom, la classe et le groupe viennent du compte : l'élève ne peut pas les changer
    function profilDuCompte(d) {
      return d.identifiant == request.auth.token.email.split('@')[0]
        && d.prenom == request.auth.token.prenom && d.nom == request.auth.token.nom
        && d.classe == request.auth.token.classe && d.groupe == request.auth.token.groupe;
    }

    // temps : temps actif sur le site (secondes, par jour et par chapitre), vuLe : dernière activité, lus par le professeur.
    // prof.maths (sans marque « groupes ») lit toutes les fiches : page « Tous les comptes »
    match /eleves/{uid} {
      // Un professeur ne lit que les élèves de ses classes (marque « groupes » ; sans elle, toutes les classes)
      allow read: if (eleve() && request.auth.uid == uid)
        || (prof() && (!('groupes' in request.auth.token) || resource.data.groupe in request.auth.token.groupes));
      allow create, update: if eleve() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['identifiant', 'prenom', 'nom', 'classe', 'groupe', 'xp', 'exo', 'qcm', 'jeux', 'avatar', 'quand', 'temps', 'vuLe', 'creeLe', 'majLe'])
        && request.resource.data.get('temps', {}) is map
        && profilDuCompte(request.resource.data);
    }
    // Liste des élèves de chaque classe (identifiant, prénom, nom), écrite seulement par outils/comptes (--classes) :
    // permet d'afficher dans le suivi les élèves jamais connectés. Un professeur lit celles de ses classes (document par document).
    match /classes/{groupe} {
      allow read: if prof() && (!('groupes' in request.auth.token) || groupe in request.auth.token.groupes);
    }
    // Progression personnelle d'un professeur (exercices faits avec son propre compte, ou compte prof approuvé),
    // avec son identité, son temps actif et sa dernière activité (temps, vuLe), lus par prof.maths (page « Tous les comptes »)
    match /profs/{uid} {
      allow read: if ((prof() || profApprouve()) && request.auth.uid == uid) || chef();
      allow create, update: if (prof() || profApprouve()) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['identifiant', 'prenom', 'nom', 'xp', 'exo', 'qcm', 'jeux', 'avatar', 'quand', 'temps', 'vuLe', 'majLe'])
        && request.resource.data.get('identifiant', idCompte()) == idCompte()
        && texte(request.resource.data.get('prenom', ''), 0, 40) && texte(request.resource.data.get('nom', ''), 0, 40)
        && request.resource.data.get('temps', {}) is map;
    }

    // ---------- Comptes créés sur le site (adresse technique @inscrits.profmaths.example.com, sans marque) ----------
    // Ils ne lisent rien des classes du professeur (élèves, classement, fréquentation).
    function inscrit() {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email.matches('[a-z0-9._-]{3,30}@inscrits[.]profmaths[.]example[.]com')
        && !('eleve' in request.auth.token) && !('prof' in request.auth.token);
    }
    function idCompte() { return request.auth.token.email.split('@')[0]; }
    // Seul le compte prof.maths (créé par outils/comptes) voit et décide les demandes
    function chef() { return prof() && request.auth.token.email == 'prof.maths@profmaths.example.com'; }
    function texte(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function profApprouve() {
      return inscrit() && get(/databases/$(database)/documents/demandesProf/$(request.auth.uid)).data.statut == 'approuve';
    }
    // Élève hors des classes du professeur (« Autres élèves ») : sa fiche, sa progression et son temps actif (temps, vuLe : lus par prof.maths)
    match /inscrits/{uid} {
      allow read: if (inscrit() && request.auth.uid == uid) || chef();
      allow create, update: if inscrit() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['identifiant', 'prenom', 'nom', 'niveau', 'xp', 'exo', 'qcm', 'jeux', 'avatar', 'quand', 'temps', 'vuLe', 'creeLe', 'majLe'])
        && request.resource.data.get('temps', {}) is map
        && request.resource.data.identifiant == idCompte()
        && texte(request.resource.data.prenom, 1, 40) && texte(request.resource.data.get('nom', ''), 0, 40)
        && texte(request.resource.data.get('niveau', ''), 0, 40);
    }
    // Demande de compte professeur : créée « en attente » par le demandeur, seul prof.maths change son statut
    match /demandesProf/{uid} {
      allow read: if (inscrit() && request.auth.uid == uid) || chef();
      allow create: if inscrit() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['identifiant', 'prenom', 'nom', 'etablissement', 'niveaux', 'contact', 'message', 'statut', 'creeLe'])
        && request.resource.data.identifiant == idCompte()
        && request.resource.data.statut == 'attente'
        && texte(request.resource.data.prenom, 1, 40) && texte(request.resource.data.nom, 1, 40)
        && texte(request.resource.data.get('etablissement', ''), 0, 80) && texte(request.resource.data.contact, 1, 80)
        && texte(request.resource.data.get('message', ''), 0, 500)
        && request.resource.data.niveaux is list && request.resource.data.niveaux.size() >= 1 && request.resource.data.niveaux.size() <= 12;
      allow update: if chef()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'decideLe'])
        && request.resource.data.statut in ['attente', 'approuve', 'refuse'];
    }
    match /classement/{uid} {
      allow read: if eleve() || prof();
      allow write: if eleve() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['prenom', 'classe', 'points', 'majLe'])
        && request.resource.data.prenom == request.auth.token.prenom
        && request.resource.data.classe == request.auth.token.classe
        && request.resource.data.points is int && request.resource.data.points >= 0;
    }

    // Fréquentation du site : compteurs anonymes (aucun nom), lus seulement par les professeurs.
    // N'importe quel visiteur peut ajouter 1 à un compteur, jamais plus d'un à la fois, jamais retirer.
    function jour(j) { return j is string && j.matches('20[0-9]{2}-[01][0-9]-[0-3][0-9]'); }
    function vaut1(k) { return !(k in request.resource.data) || request.resource.data[k] == 1; }
    function modifies() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function plusUn(k) { return !(k in modifies()) || request.resource.data[k] == resource.data.get(k, 0) + 1; }
    // Classes : un élève connecté n'ajoute 1 qu'au compteur de sa propre classe (groupe inscrit dans son compte)
    function classeOk(avant) {
      let apres = request.resource.data.get('classes', {});
      let d = apres.diff(avant).affectedKeys();
      return d.size() == 0 || (eleve() && d.hasOnly([request.auth.token.groupe])
        && apres[request.auth.token.groupe] == avant.get(request.auth.token.groupe, 0) + 1);
    }
    // Un document par jour (AAAA-MM-JJ) : visites, téléphone ou ordinateur, jeu, élèves connectés par classe
    match /visites/{j} {
      allow read: if prof();
      allow create: if jour(j) && request.resource.data.j == j
        && request.resource.data.keys().hasOnly(['j', 'visites', 'tel', 'pc', 'jeu', 'classes'])
        && vaut1('visites') && vaut1('tel') && vaut1('pc') && vaut1('jeu')
        && request.resource.data.get('classes', {}) is map && classeOk({});
      allow update: if modifies().hasOnly(['visites', 'tel', 'pc', 'jeu', 'classes'])
        && plusUn('visites') && plusUn('tel') && plusUn('pc') && plusUn('jeu')
        && request.resource.data.get('classes', {}) is map && classeOk(resource.data.get('classes', {}));
    }
    // Un document par jour et par chapitre : nombre d'ouvertures de chaque onglet
    match /visitesChap/{id} {
      allow read: if prof();
      allow create: if jour(request.resource.data.j)
        && request.resource.data.ch is string && request.resource.data.ch.matches('[a-z0-9-]{1,60}')
        && id == request.resource.data.j + '_' + request.resource.data.ch
        && request.resource.data.keys().hasOnly(['j', 'ch', 'cours', 'exercices', 'qcm', 'defi', 'methode'])
        && request.resource.data.keys().size() == 3
        && vaut1('cours') && vaut1('exercices') && vaut1('qcm') && vaut1('defi') && vaut1('methode');
      allow update: if modifies().hasOnly(['cours', 'exercices', 'qcm', 'defi', 'methode']) && modifies().size() == 1
        && plusUn('cours') && plusUn('exercices') && plusUn('qcm') && plusUn('defi') && plusUn('methode');
    }
  }
}
